{
  "name": "servicecall-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:system": "SYSTEM_TEST_URL=$BASE_URL vitest run src/__tests__/system.test.ts",
    "test:paths": "SYSTEM_TEST_URL=$BASE_URL vitest run src/__tests__/conversation-paths.test.ts",
    "test:lint": "vitest run src/lib/__tests__/data-point-lint.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "mongodb": "^7.2.0",
    "resend": "^6.9.4",
    "retell-sdk": "^5.9.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
